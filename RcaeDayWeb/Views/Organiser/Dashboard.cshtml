@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 text-success">Organiser Dashboard</h1>
            <p class="lead">Welcome back! Manage your races here.</p>
        </div>
    </div>

    <div class="row">
        <!-- Placeholder for Events List -->
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">My Events</h4>
                    <button class="btn btn-success btn-sm">Create New Event</button>
                </div>
                <div class="card-body">
                    <p class="text-muted">You haven't created any events yet. Click "Create New Event" to get started.</p>

                    <!-- We will replace this with a real table later -->
                    <table class="table table-hover mt-3 d-none">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Event rows will go here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>